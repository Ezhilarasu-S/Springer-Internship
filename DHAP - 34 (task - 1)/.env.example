# ============================================================================
# Airflow Configuration
# ============================================================================
# This is an EXAMPLE file. Copy to .env and fill in with your actual values.
# NEVER commit the .env file with real secrets to version control.

# Airflow Core Settings
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__CATCHUP_BY_DEFAULT=False

# Fernet Key for encrypting Airflow secrets
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here_change_in_production

# ============================================================================
# PostgreSQL - Airflow Metadata Database
# ============================================================================
POSTGRES_DB=airflow_db
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_airflow_password_here

# ============================================================================
# Target PostgreSQL - Data Warehouse
# ============================================================================
# These credentials are for the target PostgreSQL instance where data is loaded
TARGET_POSTGRES_HOST=postgres
TARGET_POSTGRES_PORT=5432
TARGET_POSTGRES_DB=airflow_db
TARGET_POSTGRES_USER=airflow
TARGET_POSTGRES_PASSWORD=change_me_airflow_password_here

# ============================================================================
# CSV Data Location
# ============================================================================
# Path to the source CSV file inside the container
CSV_FILE_PATH=/opt/airflow/data/dataset.csv

# ============================================================================
# Airflow Webserver Settings
# ============================================================================
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW__WEBSERVER__AUTHENTICATE=False
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# ============================================================================
# Optional: Redis Configuration (for future distributed execution)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
